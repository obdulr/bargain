# Database (Render provides DATABASE_URL automatically in production)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# SQL query logging — set to True only for local debugging.
# In production this floods logs at ~500/sec and causes Render to drop messages.
SQL_ECHO=false

# API
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Add your Render frontend URL here)
ALLOWED_ORIGINS=["http://localhost:3030","https://bargainhuntrs.com","https://www.bargainhuntrs.com","https://bargain-mhi3.onrender.com"]

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_api_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_FREE=price_your_free_price_id
STRIPE_PRICE_HUNTER=price_your_hunter_price_id
FRONTEND_URL=http://localhost:3030

# WebAuthn (passkeys)
WEB_AUTHN_RP_ID=localhost
WEB_AUTHN_RP_NAME=BargainHuntrs
WEB_AUTHN_ORIGIN=http://localhost:3030

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key

# Render sets PORT automatically, but can override locally
PORT=4030

# Buffer multi-channel auto-posting (X / Instagram / Facebook)
# Get token + channel IDs from https://buffer.com/developers
BUFFER_API_KEY=your_buffer_access_token
BUFFER_CHANNEL_ID=your_x_twitter_channel_id
BUFFER_IG_CHANNEL_ID=your_instagram_channel_id
BUFFER_FB_CHANNEL_ID=your_facebook_channel_id
BUFFER_ORG_ID=your_buffer_org_id
# Comma-separated HH:MM times in BUFFER_POST_TIMEZONE (default: 09:00,13:00,17:00 ET)
BUFFER_POST_TIMES=09:00,13:00,17:00
BUFFER_POST_TIMEZONE=America/New_York
BUFFER_POSTS_PER_WINDOW=1
BUFFER_MAX_QUEUE=10

# Impact.com Affiliate API (Walmart, ADOR, Eufy, and other brand catalogs)
IMPACT_ACCOUNT_SID=your_impact_account_sid
IMPACT_AUTH_TOKEN=your_impact_auth_token

# Amazon Associates affiliate tag (added to Amazon product links)
AMAZON_ASSOCIATES_TAG=your_amazon_associates_tag

# Walmart direct affiliate tag (used only if Impact.com Walmart isn't configured)
WALMART_AFFILIATE_ID=your_walmart_affiliate_id

# Unblocking/residential proxy for direct retailer scraping (e.g. ScraperAPI,
# Zyte API, Bright Data). REQUIRED for the Walmart scraper — walmart.com drops
# connections from unproxied cloud/datacenter IPs outright. Optional but
# recommended for Amazon (helps with occasional soft blocks/captchas).
# Format is provider-specific, e.g. ScraperAPI: http://scraperapi:YOUR_KEY@proxy-server.scraperapi.com:8001
SCRAPER_PROXY_URL=
SCRAPER_RATE_LIMIT_SECONDS=2.0
SCRAPER_MAX_RETRIES=3
